<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <CompatibilityMode Value="True"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="HashLib.Tests.Android"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes Count="1">
      <Item1 Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages Count="3">
      <Item1>
        <PackageName Value="HashLib4PascalPackage"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
      <Item3>
        <PackageName Value="LazTestInsight"/>
      </Item3>
    </RequiredPackages>
    <Units Count="1">
      <Unit0>
        <Filename Value="HashLib.Tests.Android.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value=".\bin\libHashLibAndroidTests.so"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="..\src;..\src\Utils;..\src\Utils\Parsers;..\src\Utils\Vectors;Mobile\Android"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <TargetCPU Value="aarch64"/>
      <TargetOS Value="android"/>
    </CodeGeneration>
    <Linking>
      <Options>
        <ExecutableType Value="Library"/>
      </Options>
    </Linking>
    <Other>
      <ConfigFile>
        <CustomConfigFile Value="True"/>
        <ConfigFilePath Value="..\..\BuildConfig\FPC\HashLibFPCMessages.cfg"/>
      </ConfigFile>
      <ExecuteAfter>
        <Command Value="java &quot;$(ProjPath)Mobile/Android/BuildApk.java&quot; --project-dir &quot;$(ProjPath).&quot; --library HashLibAndroidTests --app-id hashlib --title &quot;HashLib Tests&quot; --target-os $(TargetOS)"/>
      </ExecuteAfter>
    </Other>
  </CompilerOptions>
</CONFIG>
